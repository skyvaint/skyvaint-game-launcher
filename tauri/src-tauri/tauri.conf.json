{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skyvaint Game Launcher",
  "version": "3.0.0-alpha.1",
  "identifier": "com.skyvaint.gamelauncher",
  "build": {
    "frontendDist": "../../wwwroot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Skyvaint Game Launcher",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
